    {
     "@context": "https://schema.org/",
     "@type": "Recipe",
     "name": "Creamy Kale Salad Recipe",
     "description": "Full of healthy texture and flavor, this nutrient-dense Kale Salad with creamy buttermilk dressing and tamed red onions is sprinkled with an addicting crunchy salad topper.",
     "author": {
      "@type": "Person",
      "name": "Tonia | Feasting at Home"
     },
     "keywords": "Creamy kale salad, kale salad, kale salad recipe, kale salad buttermilk dressing, kale salad creamy dressing",
     "image": [
      "https://www.feastingathome.com/wp-content/uploads/2023/04/Kale-Salad-10-225x225.jpg",
      "https://www.feastingathome.com/wp-content/uploads/2023/04/Kale-Salad-10-260x195.jpg",
      "https://www.feastingathome.com/wp-content/uploads/2023/04/Kale-Salad-10-320x180.jpg",
      "https://www.feastingathome.com/wp-content/uploads/2023/04/Kale-Salad-10.jpg"
     ],
     "url": "https://www.feastingathome.com/kale-salad/",
     "recipeIngredient": [
      "1/2 cup buttermilk",
      "1 tablespoon olive oil",
      "1 tablespoon apple cider vinegar",
      "2 tablespoons mayo (or greek yogurt)",
      "1 tablespoon dijon (or whole-grain mustard)",
      "1/4-1/2  teaspoon salt",
      "1/4 teaspoon pepper",
      "1/2 small red onion, sliced in thin rounds",
      "1 cup water",
      "1 tablespoon baking soda ",
      "10-12 ounces lacinato kale, destem and cut into 1-2 inch pieces",
      "2 tablespoon olive oil",
      "2 tablespoons lemon juice",
      "1/4 teaspoon salt",
      "1/2 cup fresh dill, loosely packed",
      "1 cup quinoa, cooked",
      "2 tablespoons olive oil",
      "1/2 teaspoon salt",
      "1/2 cup sunflower seeds",
      "1/2 cup pumpkin seeds",
      "1/4 cup hempseeds",
      "1/4 cup sesame seeds",
      "1 tablespoon tamari or braggs (optional)"
     ],
     "recipeInstructions": [
      {
       "@type": "HowToStep",
       "text": "Whisk together buttermilk, olive oil, apple cider vinegar, mayo, mustard, salt and pepper. Chill this while you make the rest of the salad. Or better yet make a day or two ahead.",
       "name": "Dressing",
       "url": "https://www.feastingathome.com/kale-salad/#instruction-step-1"
      },
      {
       "@type": "HowToStep",
       "text": "Place water and baking soda in a bowl with the thinly sliced red onion rings and soak for 15 minutes. (This will neutralize and remove the pungent bitter bite.) Rinse onion slices really well with water to clean off the baking soda residue.",
       "name": "Red Onions",
       "url": "https://www.feastingathome.com/kale-salad/#instruction-step-2"
      },
      {
       "@type": "HowToStep",
       "text": "In a salad serving bowl, combine kale with olive oil, lemon juice, and salt. Massage with your hands to work the liquids and salt into the leaves, about 5 minutes or more if you want it really tender. (Lacinato kale is known to be more tender. If you use a different kale massage longer for mature kale, less for baby leaves.)",
       "name": "Kale",
       "url": "https://www.feastingathome.com/kale-salad/#instruction-step-3"
      },
      {
       "@type": "HowToStep",
       "text": "Toss cooked quinoa (thoroughly cooled- see notes) with olive oil and salt. Spread onto two sheet pans in thin layers. Bake at 350F for about 30 minutes, stirring every 10 minutes.",
       "name": "Crunchy Quinoa Topper",
       "url": "https://www.feastingathome.com/kale-salad/#instruction-step-4"
      },
      {
       "@type": "HowToStep",
       "text": "In a bowl, mix together sunflower seeds, pumpkin seeds, hempseeds, sesame seeds with 1 tablespoon tamari or Braggs. Spread onto a sheet pan and bake for 10 minutes or until desired toastiness. After the seeds completely cool, mix with the crispy quinoa and store in an airtight container up to a month.",
       "url": "https://www.feastingathome.com/kale-salad/#instruction-step-5"
      },
      {
       "@type": "HowToStep",
       "text": "Drizzle in about 1/2 of the dressing over the kale, taste and adjust salt, pepper and add more dressing (we like it saucy, but make it to your preference!). Layer on onions and dill. Top with 1/2 cup or more of quinoa crunchies. ",
       "name": "Assemble",
       "url": "https://www.feastingathome.com/kale-salad/#instruction-step-6"
      },
      {
       "@type": "HowToStep",
       "text": "Reserve the crunchy quinoa topper for sprinkling on when serving immediately.",
       "url": "https://www.feastingathome.com/kale-salad/#instruction-step-7"
      }
     ],
