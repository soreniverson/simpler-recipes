      "https://www.wellplated.com/wp-content/uploads/2024/03/Best-Crockpot-Chicken-Tacos-500x375.jpg",
      "https://www.wellplated.com/wp-content/uploads/2024/03/Best-Crockpot-Chicken-Tacos-480x270.jpg"
     ],
     "video": {
      "name": "Crockpot Chicken Tacos Video",
      "description": "Simple ingredients and 10 minutes of prep are all it tasks for this easy crockpot chicken tacos recipe. Salsa, spices, and lime juice make it the best!",
      "thumbnailUrl": "https://content.jwplatform.com/thumbs/96gkW2AZ-720.jpg",
      "contentUrl": "https://content.jwplatform.com/videos/96gkW2AZ.mp4",
      "uploadDate": "2024-10-29T00:00:00.000Z",
      "@type": "VideoObject"
     },
     "recipeYield": [
      "4",
      "4 servings"
     ],
     "prepTime": "PT10M",
     "cookTime": "PT185M",
     "totalTime": "PT195M",
     "recipeIngredient": [
      "2 pounds boneless, skinless chicken breasts or thighs",
      "1  (16-ounce) jar prepared salsa",
      "2 teaspoons ground chili powder",
      "1 teaspoons ground cumin",
      "1 teaspoon garlic powder",
      "1 teaspoon onion powder",
      "2 tablespoons freshly squeezed lime juice (from about 1 lime, plus additional for serving)",
      "¼ cup chopped fresh cilantro (plus additional for serving)",
      "Whole wheat or corn tortillas (for serving)",
      "Toppings of choice: shredded cheddar cheese, avocado, shredded lettuce"
     ],
     "recipeInstructions": [
      {
       "@type": "HowToStep",
       "text": "In the bottom of a slow cooker, stir together the salsa, chili powder, cumin, garlic powder, onion powder and lime juice.",
       "name": "Combine",
       "url": "https://www.wellplated.com/crockpot-chicken-tacos/#wprm-recipe-142728-step-0-0",
       "image": "https://www.wellplated.com/wp-content/uploads/2024/03/How-to-Make-Crockpot-Chicken-Tacos.jpg"
      },
      {
       "@type": "HowToStep",
       "text": "Add the chicken breast, turning it to coat it in the salsa mixture. Spoon some of the salsa over the top.",
       "name": "Add",
       "url": "https://www.wellplated.com/crockpot-chicken-tacos/#wprm-recipe-142728-step-0-1",
       "image": "https://www.wellplated.com/wp-content/uploads/2024/03/How-to-Make-Crockpot-Chicken-Tacos-1.jpg"
      },
      {
       "@type": "HowToStep",
       "text": "Cover and slow cook the chicken on low until the chicken is cooked registers 165°F on an instant read thermometer, 2 to 3 hours (note that slow cooker models can vary; check at the 90 minute-mark to gauge progress).",
       "name": "Cook",
       "url": "https://www.wellplated.com/crockpot-chicken-tacos/#wprm-recipe-142728-step-0-2"
      },
      {
       "@type": "HowToStep",
       "text": "With two forks, shred the chicken directly in your slow cooker (or remove it to a plate to shred if that’s easier for you, then return to the slow cooker). Add the cilantro and stir to combine. Cover and let everything warm together for 5 minutes.",
       "name": "Shred",
       "url": "https://www.wellplated.com/crockpot-chicken-tacos/#wprm-recipe-142728-step-0-3",
       "image": "https://www.wellplated.com/wp-content/uploads/2024/03/How-to-Make-Crockpot-Chicken-Tacos-2.jpg"
      },
      {
       "@type": "HowToStep",
       "text": "Warm the tortillas, either wrapped in a damp towel in the microwave or by lightly charring them over a gas stove. Fill with the chicken and add your toppings of choice.",
       "name": "Assemble",
       "url": "https://www.wellplated.com/crockpot-chicken-tacos/#wprm-recipe-142728-step-0-4",
       "image": "https://www.wellplated.com/wp-content/uploads/2024/03/How-to-Make-Crockpot-Chicken-Tacos-3.jpg"
      }
     ],
