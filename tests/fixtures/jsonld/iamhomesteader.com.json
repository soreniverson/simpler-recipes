    {
     "@type": "Recipe",
     "name": "Cowboy Butter",
     "author": {
      "@type": "Person",
      "name": "Amanda Rettke--iamhomesteader.com"
     },
     "description": "Cowboy Butter is flavored butter that can be used as a dipping sauce or formed into a log to use as a spread.",
     "datePublished": "2022-11-22T09:00:00+00:00",
     "image": [
      "https://iamhomesteader.com/wp-content/uploads/2022/11/cowboy-butter-2.jpg",
      "https://iamhomesteader.com/wp-content/uploads/2022/11/cowboy-butter-2-500x500.jpg",
      "https://iamhomesteader.com/wp-content/uploads/2022/11/cowboy-butter-2-500x375.jpg",
      "https://iamhomesteader.com/wp-content/uploads/2022/11/cowboy-butter-2-480x270.jpg"
     ],
     "video": {
      "name": "Cowboy Butter",
      "description": "Cowboy Butter is flavored butter that can be used as a dipping sauce or formed into a log to use as a spread. It’s delicious when served with steak, turkey, chicken, and more.",
      "thumbnailUrl": "https://content.jwplatform.com/thumbs/c8BcC6lp-720.jpg",
      "contentUrl": "https://content.jwplatform.com/videos/c8BcC6lp.mp4",
      "uploadDate": "2024-05-14T16:53:57.000Z",
      "@type": "VideoObject"
     },
     "recipeYield": [
      "10",
      "10 tablespoons"
     ],
     "prepTime": "PT5M",
     "totalTime": "PT5M",
     "recipeIngredient": [
      "½ cup (1 stick / 113 g) unsalted butter, (softened)",
      "1 tablespoon coarse Dijon Mustard",
      "1 tablespoon fresh chives, (chopped)",
      "1 tablespoon fresh parsley, (chopped)",
      "2 teaspoons fresh thyme,",
      "2 teaspoons garlic, (minced)",
      "1 teaspoon lemon juice",
      "½ teaspoon paprika",
      "¼ teaspoon kosher salt",
      "⅛ teaspoon pepper",
      "⅛ teaspoon cayenne pepper",
      "⅛ teaspoon crushed red pepper flakes"
     ],
     "recipeInstructions": [
      {
       "@type": "HowToStep",
       "text": "In a medium bowl, add the softened butter, dijon mustard, chives, parsley, thyme, garlic, lemon juice, paprika, salt, pepper, cayenne, and red pepper flakes. Mix together until combined. This will make about ⅔ cup of butter. (You could also mix the ingredients in a food processor.)",
       "name": "Whisk together all ingredients.",
       "url": "https://iamhomesteader.com/cowboy-butter/#wprm-recipe-116484-step-0-0"
      },
      {
       "@type": "HowToStep",
       "text": "To make a compound butter:  Scoop the cowboy butter onto a piece of plastic wrap.  Roll the butter into a log shape, pressing and shaping as you go until the butter is completely wrapped in plastic.  Twist the ends of the plastic wrap together and refrigerate until firm (2 hours up to overnight).",
       "name": "scoop butter onto plastic and wrap into a log.",
       "url": "https://iamhomesteader.com/cowboy-butter/#wprm-recipe-116484-step-0-1"
      },
      {
       "@type": "HowToStep",
       "text": "To make a butter dip: Melt the mixture in the microwave in 20-second increments, stirring in between, until fully melted.",
       "name": "melt mixture in microwave.",
       "url": "https://iamhomesteader.com/cowboy-butter/#wprm-recipe-116484-step-0-2"
      },
      {
       "@type": "HowToStep",
       "text": "Store in the refrigerator in an airtight container for up to 5 days.",
       "name": "Store in the refrigerator.",
       "url": "https://iamhomesteader.com/cowboy-butter/#wprm-recipe-116484-step-0-3"
      }
     ],
