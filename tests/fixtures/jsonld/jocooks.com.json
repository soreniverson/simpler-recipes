     ],
     "video": {
      "name": "Creamy Garlic Parmesan Mushrooms",
      "description": "These Creamy Garlic Parmesan Mushrooms are sautéed in butter and garlic until perfectly browned, then tossed in a super easy creamy Parmesan sauce that only requires 2 ingredients.",
      "thumbnailUrl": "https://content.jwplatform.com/thumbs/FHaJfLpD-720.jpg",
