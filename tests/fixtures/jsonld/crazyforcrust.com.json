     "@type": "Recipe",
     "name": "5-minute Hot Fudge Recipe",
     "author": {
      "@id": "https://www.crazyforcrust.com/#/schema/person/ef87234b40b0d0f495a4fea2bf64d34b"
     },
     "description": "Easy 5-minute Hot Fudge sauce is the perfect ice cream sundae topping. Just 3 ingredients and you have an easy chocolate sauce recipe!",
     "datePublished": "2019-07-30T03:00:20+00:00",
     "image": [
      "https://www.crazyforcrust.com/wp-content/uploads/2019/07/5-minute-hot-fudge-6.jpg",
      "https://www.crazyforcrust.com/wp-content/uploads/2019/07/5-minute-hot-fudge-6-500x500.jpg",
      "https://www.crazyforcrust.com/wp-content/uploads/2019/07/5-minute-hot-fudge-6-500x375.jpg",
      "https://www.crazyforcrust.com/wp-content/uploads/2019/07/5-minute-hot-fudge-6-480x270.jpg"
     ],
     "recipeYield": [
      "2",
      "2 cups"
     ],
     "cookTime": "PT5M",
     "totalTime": "PT5M",
     "recipeIngredient": [
      "1 (14 ounce) can (396g) sweetened condensed milk",
      "1 cup (170g) semi-sweet chocolate chips",
      "2 tablespoons (28g) unsalted butter",
      "1 teaspoon vanilla extract"
     ],
     "recipeInstructions": [
      {
       "@type": "HowToStep",
       "text": "Add sweetened condensed milk and chocolate chips to a saucepan. Heat over medium heat, stirring constantly, until chocolate chips are melted.",
       "name": "Add sweetened condensed milk and chocolate chips to a saucepan. Heat over medium heat, stirring constantly, until chocolate chips are melted.",
       "url": "https://www.crazyforcrust.com/5-minute-hot-fudge-sauce/#wprm-recipe-47007-step-0-0"
      },
      {
       "@type": "HowToStep",
       "text": "Remove from heat and stir in butter and vanilla. Stir until butter is melted.",
       "name": "Remove from heat and stir in butter and vanilla. Stir until butter is melted.",
       "url": "https://www.crazyforcrust.com/5-minute-hot-fudge-sauce/#wprm-recipe-47007-step-0-1"
      },
      {
       "@type": "HowToStep",
       "text": "Place hot fudge in a jar. Use while hot.",
       "name": "Place hot fudge in a jar. Use while hot.",
       "url": "https://www.crazyforcrust.com/5-minute-hot-fudge-sauce/#wprm-recipe-47007-step-0-2"
      },
      {
       "@type": "HowToStep",
       "text": "Store leftovers covered in the refrigerator for up to 2 weeks. To reheat: place jar in microwave and heat in 30 second increments, stirring between each, until melted and smooth.",
       "name": "Store leftovers covered in the refrigerator for up to 2 weeks. To reheat: place jar in microwave and heat in 30 second increments, stirring between each, until melted and smooth.",
       "url": "https://www.crazyforcrust.com/5-minute-hot-fudge-sauce/#wprm-recipe-47007-step-0-3"
      }
     ],
