    {
     "@type": "Recipe",
     "name": "Air Fryer Chicken Breasts",
     "author": {
      "@id": "https://www.lecremedelacrumb.com/#/schema/person/fd3774af0495fba3aa301a6a7a47d826"
     },
     "description": "Meal prep has never been so easy with these Air Fryer Chicken Breasts! Learn how to make the perfect, juicy chicken in the air fryer in not one but two ways! Perfect for topping on salads, or having in sandwiches or on pasta!",
     "datePublished": "2023-06-27T11:08:06+00:00",
     "image": [
      "https://www.lecremedelacrumb.com/wp-content/uploads/2023/06/Airfryerchickenbreast-14b-1-scaled.jpg",
      "https://www.lecremedelacrumb.com/wp-content/uploads/2023/06/Airfryerchickenbreast-14b-1-500x500.jpg",
      "https://www.lecremedelacrumb.com/wp-content/uploads/2023/06/Airfryerchickenbreast-14b-1-500x375.jpg",
      "https://www.lecremedelacrumb.com/wp-content/uploads/2023/06/Airfryerchickenbreast-14b-1-480x270.jpg"
     ],
     "video": {
      "name": "Air Fryer Chicken Breasts",
      "description": "Meal prep has never been so easy with these Air Fryer Chicken Breasts! Learn how to make the perfect, juicy chicken in the air fryer in not one but two ways! Perfect for topping on salads, or having in sandwiches or on pasta!",
      "thumbnailUrl": "https://content.jwplatform.com/thumbs/nty49VmE-720.jpg",
      "contentUrl": "https://content.jwplatform.com/videos/nty49VmE.mp4",
      "uploadDate": "2023-10-02T00:00:00.000Z",
      "@type": "VideoObject"
     },
     "recipeYield": [
      "2",
      "2 servings"
     ],
     "prepTime": "PT10M",
     "cookTime": "PT20M",
     "totalTime": "PT30M",
     "recipeIngredient": [
      "2  skinless, boneless chicken breasts",
      "¼ tsp garlic powder",
      "salt (to taste)",
      "cracked black pepper (to taste)",
      "cooking spray (see note)",
      "2  skinless, boneless chicken breasts",
      "2 tbsp flour",
      "¼ tsp garlic powder",
      "salt (to taste)",
      "cracked black pepper (to taste)",
      "1  small egg",
      "8 tbsp panko breadcrumbs",
      "cooking spray (see note)"
     ],
     "recipeInstructions": [
      {
       "@type": "HowToSection",
       "name": "To Make Seasoned Air Fryer Chicken Breasts",
       "itemListElement": [
        {
         "@type": "HowToStep",
         "text": "Season the breasts with the garlic powder, salt and pepper. Spritz with the cooking spray and cook for 15-20 minutes at 350F until the chicken is cooked through, turning halfway. The exact cooking time will depend on the thickness of the breasts.",
         "name": "Season the breasts with the garlic powder, salt and pepper. Spritz with the cooking spray and cook for 15-20 minutes at 350F until the chicken is cooked through, turning halfway. The exact cooking time will depend on the thickness of the breasts.",
         "url": "https://www.lecremedelacrumb.com/air-fryer-chicken-breasts/#wprm-recipe-58694-step-0-0"
        }
       ]
      },
      {
       "@type": "HowToSection",
       "name": "To Make Thin Breaded Air Fryer Chicken Breasts",
       "itemListElement": [
        {
         "@type": "HowToStep",
         "text": "Using a sharp knife halve the chicken breasts down the middle so you have two same size, but thinner breast pieces. Using the heel of your hand, lightly bash the thicker bits so the four pieces are of roughly the same thickness.",
         "name": "Using a sharp knife halve the chicken breasts down the middle so you have two same size, but thinner breast pieces. Using the heel of your hand, lightly bash the thicker bits so the four pieces are of roughly the same thickness.",
         "url": "https://www.lecremedelacrumb.com/air-fryer-chicken-breasts/#wprm-recipe-58694-step-1-0"
        },
        {
         "@type": "HowToStep",
         "text": "Combine the flour, garlic powder, and a little salt and pepper in the bottom of a shallow bowl. In another, lightly beat the egg with a little more salt and pepper. In a third, add the panko breadcrumbs. ",
         "name": "Combine the flour, garlic powder, and a little salt and pepper in the bottom of a shallow bowl. In another, lightly beat the egg with a little more salt and pepper. In a third, add the panko breadcrumbs. ",
         "url": "https://www.lecremedelacrumb.com/air-fryer-chicken-breasts/#wprm-recipe-58694-step-1-1"
        },
        {
         "@type": "HowToStep",
         "text": "Dip the chicken pieces first in the flour mixture, then the egg, then the breadcrumbs so they are well coated. Use one hand for the flour and crumbs, and another for the egg to avoid coating your fingers! ",
         "name": "Dip the chicken pieces first in the flour mixture, then the egg, then the breadcrumbs so they are well coated. Use one hand for the flour and crumbs, and another for the egg to avoid coating your fingers! ",
         "url": "https://www.lecremedelacrumb.com/air-fryer-chicken-breasts/#wprm-recipe-58694-step-1-2"
        },
        {
         "@type": "HowToStep",
         "text": "Spritz the breaded chicken pieces on both side with cooking spray and cook for 20 minutes at 350F, turning halfway, until the breadcrumbs are golden and crispy. ",
         "name": "Spritz the breaded chicken pieces on both side with cooking spray and cook for 20 minutes at 350F, turning halfway, until the breadcrumbs are golden and crispy. ",
         "url": "https://www.lecremedelacrumb.com/air-fryer-chicken-breasts/#wprm-recipe-58694-step-1-3"
        }
       ]
      }
     ],
