     "recipeIngredient": [
      "1 pâte feuilletée",
      "1 rouleau de fromage de chèvre",
      "2 tomates",
      "2 cuillères à café de moutarde",
      "poivre",
      "sel",
      "basilic séché"
     ],
     "recipeInstructions": [
      {
       "@type": "HowToStep",
       "text": "Faire précuire la pâte feuilletée préalablement piquée avec une fourchette entre 10 et 15 mn à 250°C au four. "
      },
      {
       "@type": "HowToStep",
       "text": "Pendant ce temps, couper les tomates en tranches que vous disposerez sur une assiette en alternance avec de l'essuie tout pour absorber l'humidité. "
      },
      {
       "@type": "HowToStep",
       "text": "Couper le chèvre en grosses tranches (environ 10 ). "
      },
      {
       "@type": "HowToStep",
       "text": "Sortir la pâte du four, et la badigeonner de moutarde. "
      },
      {
       "@type": "HowToStep",
       "text": "Disposer les tranches de tomates et par dessus les tranches de chèvre. "
      },
      {
       "@type": "HowToStep",
       "text": "Saler et poivrer, et parsemer de basilic. "
      },
      {
       "@type": "HowToStep",
       "text": "Remettre au four environ 10 mn que le chèvre fonde."
      }
     ],
