     "recipeYield": [
      "6"
     ],
     "prepTime": "PT10M",
     "cookTime": "PT300M",
     "totalTime": "PT310M",
     "recipeIngredient": [
      "32 ounce container chicken broth",
      "10.5 ounce can cream of chicken soup with herbs",
      "1 cup diced onion",
      "1 cup diced celery",
      "3-4  frozen chicken breasts ((see note below))",
      "1-2 teaspoons garlic salt",
      "1/2 teaspoon black pepper",
      "1 cup frozen peas and carrots, (optional)",
      "16 ounce tube Pillsbury Grands Refrigerated Biscuits",
      "1/2 cup all purpose flour"
     ],
     "recipeInstructions": [
      {
       "@type": "HowToStep",
       "text": "Place 32 ounce&#32;container chicken broth, 10.5 ounce&#32;can cream of chicken soup with herbs, 1 cup&#32;diced onion and 1 cup&#32;diced celery into a 5-6 quart oval slow cooker. Stir well (it will be a bit lumpy from the cream of chicken soup.)",
       "name": "Place 32 ounce&#32;container chicken broth, 10.5 ounce&#32;can cream of chicken soup with herbs, 1 cup&#32;diced onion and 1 cup&#32;diced celery into a 5-6 quart oval slow cooker. Stir well (it will be a bit lumpy from the cream of chicken soup.)",
       "url": "https://www.thecountrycook.net/crock-pot-chicken-and-dumplings/#wprm-recipe-25077-step-0-0",
       "video": {
        "@id": "#wprm-recipe-25077-step-0-0"
       }
      },
      {
       "@type": "HowToStep",
       "text": "Add 3-4&#32;frozen chicken breasts into crock pot and season with 1-2 teaspoons&#32;garlic salt and 1/2 teaspoon&#32;black pepper.",
       "name": "Add 3-4&#32;frozen chicken breasts into crock pot and season with 1-2 teaspoons&#32;garlic salt and 1/2 teaspoon&#32;black pepper.",
       "url": "https://www.thecountrycook.net/crock-pot-chicken-and-dumplings/#wprm-recipe-25077-step-0-1",
       "video": {
        "@id": "#wprm-recipe-25077-step-0-1"
       }
      },
      {
       "@type": "HowToStep",
       "text": "Cover and cook on low for about 4-6 hours (until chicken is fully cooked through.)",
       "name": "Cover and cook on low for about 4-6 hours (until chicken is fully cooked through.)",
       "url": "https://www.thecountrycook.net/crock-pot-chicken-and-dumplings/#wprm-recipe-25077-step-0-2",
       "video": {
        "@id": "#wprm-recipe-25077-step-0-2"
       }
      },
      {
       "@type": "HowToStep",
       "text": "Then take the chicken out and cut it into bite size pieces or shred it with a couple of forks. Put the chicken back into the slow cooker. Add 1 cup&#32;frozen peas and carrots, into the slow cooker if you are using.",
       "name": "Then take the chicken out and cut it into bite size pieces or shred it with a couple of forks. Put the chicken back into the slow cooker. Add 1 cup&#32;frozen peas and carrots, into the slow cooker if you are using.",
       "url": "https://www.thecountrycook.net/crock-pot-chicken-and-dumplings/#wprm-recipe-25077-step-0-3",
       "video": {
        "@id": "#wprm-recipe-25077-step-0-3"
       }
      },
      {
       "@type": "HowToStep",
       "text": "Take the 16 ounce&#32;tube Pillsbury Grands Refrigerated Biscuits, separate them and flatten each one with the palm of your hand (or roll them out). Then cut the biscuits into strips then cut down the center.",
       "name": "Take the 16 ounce&#32;tube Pillsbury Grands Refrigerated Biscuits, separate them and flatten each one with the palm of your hand (or roll them out). Then cut the biscuits into strips then cut down the center.",
       "url": "https://www.thecountrycook.net/crock-pot-chicken-and-dumplings/#wprm-recipe-25077-step-0-4",
       "video": {
        "@id": "#wprm-recipe-25077-step-0-4"
       }
      },
      {
       "@type": "HowToStep",
       "text": "Put 1/2 cup&#32;all purpose flour into a bowl and place slices of biscuits into the flour and toss them to coat well with the flour.",
       "name": "Put 1/2 cup&#32;all purpose flour into a bowl and place slices of biscuits into the flour and toss them to coat well with the flour.",
       "url": "https://www.thecountrycook.net/crock-pot-chicken-and-dumplings/#wprm-recipe-25077-step-0-5",
       "video": {
        "@id": "#wprm-recipe-25077-step-0-5"
       }
      },
      {
       "@type": "HowToStep",
       "text": "Drop the coated biscuits (one by one into the slow cooker.) Take a spoon and gently push the biscuits down under the broth so the tops get moistened (don&#39;t stir.)",
       "name": "Drop the coated biscuits (one by one into the slow cooker.) Take a spoon and gently push the biscuits down under the broth so the tops get moistened (don&#39;t stir.)",
       "url": "https://www.thecountrycook.net/crock-pot-chicken-and-dumplings/#wprm-recipe-25077-step-0-6",
       "video": {
        "@id": "#wprm-recipe-25077-step-0-6"
       }
      },
      {
       "@type": "HowToStep",
       "text": "Cover and cook on high for about 1 to 1 1/2 hours. Gently stir occasionally. Carefully take a dumpling out and check to make sure it is cooked through. If not, continue to cook until done.",
       "name": "Cover and cook on high for about 1 to 1 1/2 hours. Gently stir occasionally. Carefully take a dumpling out and check to make sure it is cooked through. If not, continue to cook until done.",
       "url": "https://www.thecountrycook.net/crock-pot-chicken-and-dumplings/#wprm-recipe-25077-step-0-7",
       "video": {
        "@id": "#wprm-recipe-25077-step-0-7"
       }
      },
      {
       "@type": "HowToStep",
       "text": "Sprinkle with some dried parsley (optional.) Then serve!",
       "name": "Sprinkle with some dried parsley (optional.) Then serve!",
       "url": "https://www.thecountrycook.net/crock-pot-chicken-and-dumplings/#wprm-recipe-25077-step-0-8",
       "video": {
        "@id": "#wprm-recipe-25077-step-0-8"
       }
      }
