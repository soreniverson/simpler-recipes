     "recipeIngredient": [
      "1 tablespoon olive oil",
      "4 pound chuck roast",
      "salt and pepper to taste",
      "2 1/2 cups beef broth",
      "1 tablespoon tomato paste",
      "1 tablespoon Worcestershire sauce",
      "1 tablespoon minced garlic",
      "1  teaspoon dried Italian seasoning",
      "1  bay leaf",
      "1 teaspoon smoked paprika",
      "1  onion (peeled and cut into wedges)",
      "2 pounds small Yukon gold potatoes (whole or halved)",
      "1 pound carrots (peeled, halved and cut into 2 inch pieces)",
      "3 slices bacon",
      "2 tablespoons corn starch",
      "2 tablespoons chopped parsley"
     ],
     "recipeInstructions": [
      {
       "@type": "HowToStep",
       "text": "Heat the oil in a large pot over medium high heat. Season the roast generously all over with salt and pepper.",
       "name": "Heat the oil in a large pot over medium high heat. Season the roast generously all over with salt and pepper.",
       "url": "https://www.dinneratthezoo.com/slow-cooker-pot-roast/#wprm-recipe-26984-step-0-0"
      },
      {
       "@type": "HowToStep",
       "text": "Place the meat in the pan. Cook for 4-5 minutes per side or until browned.",
       "name": "Place the meat in the pan. Cook for 4-5 minutes per side or until browned.",
       "url": "https://www.dinneratthezoo.com/slow-cooker-pot-roast/#wprm-recipe-26984-step-0-1"
      },
      {
       "@type": "HowToStep",
       "text": "Place the beef broth, tomato paste, Worcestershire sauce, garlic, Italian seasoning, bay leaf, smoked paprika and salt and pepper in the bottom of a large slow cooker. Whisk to combine.",
       "name": "Place the beef broth, tomato paste, Worcestershire sauce, garlic, Italian seasoning, bay leaf, smoked paprika and salt and pepper in the bottom of a large slow cooker. Whisk to combine.",
       "url": "https://www.dinneratthezoo.com/slow-cooker-pot-roast/#wprm-recipe-26984-step-0-2"
      },
      {
       "@type": "HowToStep",
       "text": "Arrange the onions, carrots and potatoes in the bottom of the slow cooker. Place the roast on top.",
       "name": "Arrange the onions, carrots and potatoes in the bottom of the slow cooker. Place the roast on top.",
       "url": "https://www.dinneratthezoo.com/slow-cooker-pot-roast/#wprm-recipe-26984-step-0-3"
      },
      {
       "@type": "HowToStep",
       "text": "Lay the slices of bacon on top of the roast. Cover and cook for 6-8 hours on low heat.",
       "name": "Lay the slices of bacon on top of the roast. Cover and cook for 6-8 hours on low heat.",
       "url": "https://www.dinneratthezoo.com/slow-cooker-pot-roast/#wprm-recipe-26984-step-0-4"
      },
      {
       "@type": "HowToStep",
       "text": "Remove the meat and vegetables from the pot and arrange on a serving platter. Discard the bay leaf and bacon.",
       "name": "Remove the meat and vegetables from the pot and arrange on a serving platter. Discard the bay leaf and bacon.",
       "url": "https://www.dinneratthezoo.com/slow-cooker-pot-roast/#wprm-recipe-26984-step-0-5"
      },
      {
       "@type": "HowToStep",
       "text": "Pour the liquid from the slow cooker through a strainer into a medium sized saucepan. Skim any fat from the liquid. Bring the liquid to a simmer over medium heat.",
       "name": "Pour the liquid from the slow cooker through a strainer into a medium sized saucepan. Skim any fat from the liquid. Bring the liquid to a simmer over medium heat.",
       "url": "https://www.dinneratthezoo.com/slow-cooker-pot-roast/#wprm-recipe-26984-step-0-6"
      },
      {
       "@type": "HowToStep",
       "text": "Whisk together the corn starch with 3 tablespoons of cold water. Add the corn starch mixture to the pan of liquid. Bring to a boil and cook for 1 minute or until gravy has just thickened.",
       "name": "Whisk together the corn starch with 3 tablespoons of cold water. Add the corn starch mixture to the pan of liquid. Bring to a boil and cook for 1 minute or until gravy has just thickened.",
       "url": "https://www.dinneratthezoo.com/slow-cooker-pot-roast/#wprm-recipe-26984-step-0-7"
      },
      {
       "@type": "HowToStep",
       "text": "Pour the sauce over the meat and vegetables. Sprinkle with parsley, then serve.",
       "name": "Pour the sauce over the meat and vegetables. Sprinkle with parsley, then serve.",
       "url": "https://www.dinneratthezoo.com/slow-cooker-pot-roast/#wprm-recipe-26984-step-0-8"
      }
