     ],
     "video": {
      "name": "Slow Cooker Pot Roast",
      "description": "This slow cooker pot roast is a chuck roast simmered to tender perfection in a crock pot with carrots and potatoes. A comfort food classic that's simple to make, and is great for feeding a crowd.",
      "thumbnailUrl": "https://content.jwplatform.com/thumbs/KUd5BSNM-720.jpg",
