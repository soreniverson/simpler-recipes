      {
       "@type": "Review",
       "reviewRating": {
        "@type": "Rating",
        "ratingValue": "5"
       },
       "reviewBody": "This truly is the “perfect basmati rice”! Tried and true, this recipe never fails. I use Tilda Basmati rice, and it is the perfect amount of water. This recipe is much better than the package directions!",
       "author": {
        "@type": "Person",
