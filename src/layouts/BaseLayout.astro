---
import Header from '../components/Header.jsx';

export interface Props {
  title: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  canonical?: string;
  /** Set true for pages that must not be indexed (client-only shells, auth callbacks, user data). */
  noindex?: boolean;
  /** Hide the global header (e.g. focused reading surfaces). */
  hideHeader?: boolean;
  /** Hide the header search box (the homepage has its own hero input). */
  headerSearch?: boolean;
}

const {
  title,
  description = "Paste any recipe link and get just the recipe — ingredients and steps, no ads, no life story.",
  image = "/og-default.png",
  type = "website",
  canonical,
  noindex = false,
  hideHeader = false,
  headerSearch = true,
} = Astro.props;

export const SITE_URL = "https://www.simpler.recipes";
const siteUrl = SITE_URL;
const fullImageUrl = image.startsWith('http') ? image : `${siteUrl}${image}`;
// Canonical: always the www host, path from the current page unless overridden.
const canonicalUrl = canonical || new URL(Astro.url.pathname, siteUrl).href;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content="#F6F5F3" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#141311" media="(prefers-color-scheme: dark)" />

    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={fullImageUrl} />
    <meta property="og:site_name" content="Simpler Recipes" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={fullImageUrl} />

    <!-- Fonts: self-hosted Geist (variable), latin subset preloaded -->
    <link rel="preload" href="/fonts/geist-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin />

    <!-- Theme initialization (must run before body renders to prevent flash) -->
    <script is:inline>
      (function() {
        var theme = 'system';
        try {
          var stored = localStorage.getItem('simpler-recipes-settings');
          if (stored) { var s = JSON.parse(stored); if (s.theme) theme = s.theme; }
        } catch (e) {}
        var mq = window.matchMedia('(prefers-color-scheme: dark)');
        var dark = theme === 'system' ? mq.matches : theme === 'dark';
        if (dark) document.documentElement.classList.add('dark');
        // "System" follows the OS live (the Appearance setting re-reads storage on change).
        try {
          mq.addEventListener('change', function (e) {
            var t = 'system';
            try { var st = localStorage.getItem('simpler-recipes-settings'); if (st) { var o = JSON.parse(st); if (o.theme) t = o.theme; } } catch (err) {}
            if (t !== 'system') return;
            document.documentElement.classList.toggle('dark', e.matches);
          });
        } catch (e) {}
      })();
    </script>

    <!-- Google Analytics: loaded after the page is interactive so it never competes with content -->
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-RJR6YF1HVL', { send_page_view: true });
      (function () {
        var load = function () {
          var s = document.createElement('script');
          s.async = true;
          s.src = 'https://www.googletagmanager.com/gtag/js?id=G-RJR6YF1HVL';
          document.head.appendChild(s);
        };
        if ('requestIdleCallback' in window) requestIdleCallback(load, { timeout: 4000 });
        else window.addEventListener('load', function () { setTimeout(load, 1500); });
      })();
    </script>

    <!-- Page-specific head content (structured data, extra meta) -->
    <slot name="head" />
  </head>
  <body class="bg-background text-sand-900 min-h-screen antialiased">
    <a href="#main-content" class="skip-link">
      Skip to main content
    </a>
    {!hideHeader && <Header client:idle showSearch={headerSearch} />}
    <slot />
  </body>
</html>

<style is:global>
  @tailwind base;
  @tailwind components;
  @tailwind utilities;

  @font-face {
    font-family: 'Geist';
    font-style: normal;
    font-display: swap;
    font-weight: 100 900;
    src: url(/fonts/geist-latin-wght-normal.woff2) format('woff2-variations');
    unicode-range: U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD;
  }
  @font-face {
    font-family: 'Geist';
    font-style: normal;
    font-display: swap;
    font-weight: 100 900;
    src: url(/fonts/geist-latin-ext-wght-normal.woff2) format('woff2-variations');
    unicode-range: U+0100-02BA,U+02BD-02C5,U+02C7-02CC,U+02CE-02D7,U+02DD-02FF,U+0304,U+0308,U+0329,U+1D00-1DBF,U+1E00-1E9F,U+1EF2-1EFF,U+2020,U+20A0-20AB,U+20AD-20C0,U+2113,U+2C60-2C7F,U+A720-A7FF;
  }
  /* Metric-compatible fallback so text doesn't jump when Geist arrives. */
  @font-face {
    font-family: 'Geist Fallback';
    src: local('Arial'), local('Helvetica Neue'), local('Helvetica');
    size-adjust: 104%;
    ascent-override: 92%;
    descent-override: 24%;
    line-gap-override: 0%;
  }

  /* ---------- Design tokens ---------- */
  /* Light mode (default). Text tints from sand-500 up are AA on sand-50; sand-400 is for hairlines only. */
  :root {
    --sand-25: #FEFEFE;
    --sand-50: #FCFBFA;
    --sand-100: #F5F4F1;
    --sand-200: #EBEAE6;
    --sand-300: #DDDCD7;
    --sand-400: #BEBDB7;
    --sand-500: #706f6b;
    --sand-600: #5e5d59;
    --sand-700: #4a4946;
    --sand-800: #3A3832;
    --sand-900: #1F1E1B;
    --sand-950: #0F0E0D;
    --primary: #4a4946;
    --primary-light: #5e5d59;
    --surface: #FCFBFA;
    --background: #F6F5F3;
    --on-primary: #FCFBFA;
    --shadow-color: rgba(58, 56, 50, 0.06);
    color-scheme: light;
  }

  /* Dark mode. The tint ramp keeps the SAME direction as light (25 darkest surface → 300 lightest
     hairline), so `bg-sand-100` is a subtle raised surface and `hover:bg-sand-100` lifts, not sinks. */
  :root.dark {
    --sand-25: #1a1917;
    --sand-50: #242321;
    --sand-100: #2b2a27;
    --sand-200: #34322f;
    --sand-300: #403e3a;
    --sand-400: #575551;
    --sand-500: #93918d;
    --sand-600: #a5a39f;
    --sand-700: #bcbab6;
    --sand-800: #d3d1cd;
    --sand-900: #e9e8e4;
    --sand-950: #f5f4f1;
    --primary: #bcbab6;
    --primary-light: #d3d1cd;
    --surface: #242321;
    --background: #141311;
    --on-primary: #141311;
    --shadow-color: rgba(0, 0, 0, 0.4);
    color-scheme: dark;
  }

  html {
    font-size: 16px;
    line-height: 1.5;
    -webkit-text-size-adjust: 100%;
    font-family: 'Geist', 'Geist Fallback', ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, sans-serif;
  }

  body {
    text-rendering: optimizeLegibility;
  }

  img { max-width: 100%; height: auto; }

  .tabular { font-variant-numeric: tabular-nums; }

  .skip-link {
    @apply absolute -top-16 left-2 bg-sand-900 text-sand-50 px-4 py-2 rounded-lg z-[100];
    transition: top 0.2s;
  }
  .skip-link:focus { @apply top-2; }

  /* ---------- Buttons: one system (components layer so utilities like `hidden` still win) ---------- */
  @layer components {
    .btn {
      @apply inline-flex items-center justify-center gap-2 h-11 px-4 rounded-lg text-[15px] font-medium leading-none whitespace-nowrap select-none transition-colors;
    }
    .btn-sm { @apply h-9 px-3 text-[14px]; }
    .btn:disabled { @apply opacity-40 cursor-not-allowed; }
    .btn-primary { @apply btn bg-sand-900 text-sand-50 hover:bg-sand-800; }
    .btn-secondary { @apply btn bg-sand-100 text-sand-800 hover:bg-sand-200; }
    .btn-ghost { @apply btn text-sand-700 hover:bg-sand-100 hover:text-sand-900; }
    .btn-icon { @apply inline-flex items-center justify-center h-11 w-11 rounded-lg text-sand-600 hover:bg-sand-100 hover:text-sand-900 transition-colors; }
    .btn-lg { @apply h-12 px-5 text-base; }
  }

  /* ---------- Focus ---------- */
  :focus-visible { @apply outline outline-2 outline-offset-2 outline-sand-700; }
  input:focus-visible, textarea:focus-visible { @apply outline-none; }

  /* ---------- Print: a one-or-two page recipe card, always light ---------- */
  @media print {
    @page { margin: 12mm 14mm; }
    /* Force the light palette regardless of dark-mode class or OS preference. */
    :root, :root.dark {
      --sand-25: #FFFFFF; --sand-50: #FFFFFF; --sand-100: #F5F4F1; --sand-200: #E5E4E0; --sand-300: #D6D5D0;
      --sand-400: #B5B4AE; --sand-500: #6a6965; --sand-600: #55544f; --sand-700: #403f3b; --sand-800: #2c2b27;
      --sand-900: #161512; --sand-950: #000000; --surface: #FFFFFF; --background: #FFFFFF; --on-primary: #FFFFFF;
      color-scheme: light;
    }
    html { font-size: 11pt; }
    body, main { background: #fff !important; color: #161512 !important; }
    .no-print, header[data-site-header], .skip-link, nav[aria-label="Breadcrumb"], [data-print-hide] { display: none !important; }
    .print-only { display: block !important; }
    a { text-decoration: none; color: inherit; }
    img { max-width: 100%; }
    /* Recipe view: single column, ingredients in two columns, tight rows. */
    [data-recipe-view] { max-width: none !important; padding: 0 !important; }
    [data-recipe-view] header { display: block !important; margin-bottom: 8pt !important; }
    [data-recipe-view] h1 { font-size: 20pt !important; line-height: 1.15 !important; margin: 0 0 4pt !important; }
    [data-recipe-view] [data-meta] { font-size: 10pt !important; margin-top: 2pt !important; }
    [data-recipe-view] [data-body] { display: block !important; }
    [data-recipe-view] aside { position: static !important; max-height: none !important; overflow: visible !important; margin: 10pt 0 12pt !important; }
    [data-recipe-view] aside > div { border: 0 !important; padding: 0 !important; background: none !important; }
    [data-recipe-view] h2 { font-size: 9pt !important; margin: 0 0 4pt !important; break-after: avoid; }
    [data-recipe-view] h3 { font-size: 10.5pt !important; margin: 6pt 0 2pt !important; break-after: avoid; }
    [data-ingredients] ul { columns: 2; column-gap: 18pt; }
    [data-ingredients] li { break-inside: avoid; }
    [data-ingredients] label { padding: 2pt 0 !important; margin: 0 !important; gap: 6pt !important; }
    [data-ingredients] label > span:first-of-type { width: 9pt !important; height: 9pt !important; margin-top: 3pt !important; border-radius: 2pt !important; border-color: #8a8984 !important; background: #fff !important; }
    [data-ingredients] label > span:last-of-type { font-size: 10pt !important; line-height: 1.35 !important; color: #161512 !important; text-decoration: none !important; }
    [data-instructions] ol { margin: 0 !important; }
    [data-instructions] li { break-inside: avoid; margin-bottom: 5pt !important; gap: 8pt !important; }
    [data-instructions] li > button { width: 16pt !important; height: 16pt !important; margin: 0 !important; background: none !important; color: #161512 !important; font-size: 10pt !important; }
    [data-instructions] li p { font-size: 10.5pt !important; line-height: 1.4 !important; max-width: none !important; color: #161512 !important; }
    [data-recipe-view] .print-source { display: block !important; margin-top: 10pt; font-size: 9pt; color: #55544f; }
  }

  /* Respect user preference for reduced motion */
  @media (prefers-reduced-motion: reduce) {
    *, *::before, *::after {
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
      transition-duration: 0.01ms !important;
      scroll-behavior: auto !important;
    }
  }
</style>
