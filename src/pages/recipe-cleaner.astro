---
import BaseLayout from '../layouts/BaseLayout.astro';
import CleanBox from '../components/CleanBox.jsx';

/**
 * Task-intent landing page: "recipe cleaner". The tool IS the page — paste a URL above
 * the fold, get the clean recipe. The editorial companion (why sites are like this)
 * lives at /why-recipe-sites-have-long-stories/.
 */
const SITE = 'https://www.simpler.recipes';
const pageUrl = `${SITE}/recipe-cleaner/`;
const title = 'Recipe cleaner — paste a link, get just the recipe · Simpler Recipes';
const description =
  'Free recipe cleaner: paste any recipe URL and get the ingredients and steps without ads, pop-ups or the life story. Works on most recipe sites, right in your browser.';

const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebPage',
      '@id': pageUrl,
      url: pageUrl,
      name: 'Recipe cleaner',
      description,
      isPartOf: { '@type': 'WebSite', name: 'Simpler Recipes', url: `${SITE}/` },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Simpler Recipes', item: `${SITE}/` },
        { '@type': 'ListItem', position: 2, name: 'Recipe cleaner', item: pageUrl },
      ],
    },
  ],
}).replace(/</g, '\\u003c');
---

<BaseLayout title={title} description={description} canonical={pageUrl}>
  <Fragment slot="head">
    <script type="application/ld+json" is:inline set:html={jsonLd} />
  </Fragment>

  <main id="main-content" class="min-h-screen bg-background">
    <div class="max-w-[720px] mx-auto px-4 sm:px-6 py-10 md:py-16">
      <header class="mb-7">
        <h1 class="font-serif text-[32px] sm:text-[38px] leading-[1.15] font-medium tracking-[-0.01em] text-sand-900">Recipe cleaner</h1>
        <p class="mt-3 text-[17px] text-sand-700">Paste a recipe link. Get the ingredients and the steps — nothing else.</p>
      </header>

      <CleanBox client:load id="cleaner-input" examples={true} autoFocus={false} />

      <section class="mt-12 space-y-5 text-[16px] leading-relaxed text-sand-700">
        <h2 class="font-serif text-[22px] font-medium text-sand-900">How it works</h2>
        <ol class="list-decimal pl-5 space-y-2">
          <li>Paste the link to any recipe page.</li>
          <li>We fetch the page and read the recipe data most sites publish under the surface. When a page has none, we read the page text more carefully — that fallback is the only part with a per-person limit.</li>
          <li>You get a clean page: ingredients you can check off and scale, steps you can follow in a hands-free Cook Mode, and a link back to the original.</li>
        </ol>
        <p>
          The cleaned recipe stays on your device unless you choose to share it. Quantities and steps are kept as the author wrote them — nothing is paraphrased or invented — and every recipe credits and links its source.
        </p>
        <p>
          It works on most recipe sites. A few social apps and sites that block automated readers won't work; you'll get a plain explanation instead of a spinner.
        </p>
        <p class="text-[15px]">
          Want to see the end result first? Here's a cleaned recipe from our catalog:
          <a href="/recipes/chicken-tikka-masala/" class="text-sand-800 underline underline-offset-[3px] decoration-sand-400 hover:decoration-sand-800">Chicken Tikka Masala</a>.
          Curious why recipe pages got this way? <a href="/why-recipe-sites-have-long-stories/" class="text-sand-800 underline underline-offset-[3px] decoration-sand-400 hover:decoration-sand-800">We wrote it up</a>.
        </p>
      </section>
    </div>
  </main>
</BaseLayout>
