---
import BaseLayout from '../../layouts/BaseLayout.astro';
import RecipeGrid from '../../components/RecipeGrid.jsx';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ListingHeader from '../../components/ListingHeader.astro';
import CleanBoxCard from '../../components/CleanBoxCard.astro';
import BrowseChips from '../../components/BrowseChips.astro';
import fs from 'fs';
import path from 'path';
import { buildBrowsePages } from '../../lib/browse';
import { cardImage } from '../../lib/images';
import { jsonLd, breadcrumbLd, collectionPageLd, SITE } from '../../lib/schema';

export async function getStaticPaths() {
  const dataPath = path.join(process.cwd(), 'recipe-data', 'all-recipes.json');
  const data = JSON.parse(fs.readFileSync(dataPath, 'utf-8'));
  const bySlug = new Map<string, any>(data.recipes.map((r: any) => [r.slug, r]));
  // Curated collections cross-link into the browse pages so they stop dead-ending.
  const browse = buildBrowsePages(data.recipes).map((p) => ({ slug: p.slug, name: p.name, count: p.recipes.length }));

  return data.collections.map((collection: any, i: number) => {
    // Cards only need a slim projection; the master file is the source of truth for recipe data.
    const recipes = collection.recipes
      .map((s: string) => bySlug.get(s))
      .filter(Boolean)
      .map((r: any) => ({ slug: r.slug, title: r.title, image: r.image, totalTime: r.totalTime, servings: r.servings, ingredients: r.ingredients, tags: r.tags }));
    return {
      params: { slug: collection.slug },
      props: {
        collection: { slug: collection.slug, name: collection.name, description: collection.description },
        recipes,
        // Rotate which browse pages each collection surfaces so links vary across pages.
        others: [...browse.slice(i % browse.length), ...browse].slice(0, 8),
      },
    };
  });
}

interface Props {
  collection: { slug: string; name: string; description: string };
  recipes: { slug: string; title: string; image: string | null; totalTime: string | null; servings: string | null; ingredients: string[]; tags: string[] }[];
  others: { slug: string; name: string; count: number }[];
}
const { collection, recipes: rawRecipes, others } = Astro.props as Props;
// Cards render at ≤ 400px wide (4-col grid on 1080px, 2-col on phones) → 480×360 covers 2× on phones too.
const recipes = await Promise.all(
  rawRecipes.map(async (r) => { const img = await cardImage(r.image); return { ...r, image: img?.src ?? r.image, imageSet: img?.set ?? null }; })
);

const pageUrl = `${SITE}/collection/${collection.slug}/`;
const top = recipes.slice(0, 3).map((r) => r.title);
const title = `${collection.name} — ${recipes.length} recipes · Simpler Recipes`;
const description = `${collection.description}. ${recipes.length} clean, ad-free recipes including ${top.join(', ')}. Check-off ingredients, scaling and a hands-free Cook Mode on every one.`;

const crumbs = [{ name: collection.name }];
const ld = jsonLd(
  collectionPageLd({ url: pageUrl, name: collection.name, description: collection.description, items: recipes.map((r) => ({ url: `/recipes/${r.slug}/`, name: r.title, image: r.image })) }),
  breadcrumbLd(crumbs, pageUrl)
);
---

<BaseLayout title={title} description={description} canonical={pageUrl}>
  <Fragment slot="head">
    <script type="application/ld+json" is:inline set:html={ld} />
  </Fragment>

  <main id="main-content" class="min-h-screen bg-background">
    <div class="max-w-[1080px] mx-auto px-4 sm:px-6 py-6 md:py-10">
      <Breadcrumbs crumbs={crumbs} />
      <ListingHeader title={collection.name} intro={`${collection.description}.`} count={recipes.length} />

      <section aria-label="Recipes in this collection">
        <RecipeGrid client:visible recipes={recipes} />
      </section>

      <CleanBoxCard id="collection-clean" />
      <BrowseChips items={others.map((o) => ({ name: o.name, href: `/browse/${o.slug}/`, count: o.count }))} />
    </div>
  </main>
</BaseLayout>
