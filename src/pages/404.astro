---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found · Simpler Recipes" description="That page doesn't exist." noindex={true}>
  <main id="main-content" class="min-h-[60vh] flex items-center">
    <div class="max-w-xl mx-auto px-4 py-16 text-center">
      <p class="text-[13px] font-medium uppercase tracking-[0.06em] text-sand-500">404</p>
      <h1 class="mt-2 font-serif text-[26px] sm:text-[30px] font-medium text-sand-900">That page doesn't exist</h1>
      <p class="mt-3 text-[16px] text-sand-600">If you were looking for a recipe, paste its link on the homepage and we'll pull it out for you.</p>
      <div class="mt-6 flex items-center justify-center gap-3">
        <a href="/" class="btn-primary">Go home</a>
        <a href="/collection/quick-weeknight-dinners/" class="btn-ghost">Browse recipes</a>
      </div>
    </div>
  </main>
</BaseLayout>
