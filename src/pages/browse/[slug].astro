---
import BaseLayout from '../../layouts/BaseLayout.astro';
import RecipeGrid from '../../components/RecipeGrid.jsx';
import CleanBox from '../../components/CleanBox.jsx';
import fs from 'fs';
import path from 'path';
import { buildBrowsePages } from '../../lib/browse';
import { cardImage } from '../../lib/images';

export async function getStaticPaths() {
  const dataPath = path.join(process.cwd(), 'recipe-data', 'all-recipes.json');
  const data = JSON.parse(fs.readFileSync(dataPath, 'utf-8'));
  const pages = buildBrowsePages(data.recipes);
  const all = pages.map((p) => ({ slug: p.slug, name: p.name, count: p.recipes.length }));
  return pages.map((page) => ({
    params: { slug: page.slug },
    props: {
      page: { slug: page.slug, name: page.name, intro: page.intro },
      recipes: page.recipes.map((r) => ({ slug: r.slug, title: r.title, image: r.image, totalTime: r.totalTime, servings: r.servings, ingredients: r.ingredients, tags: r.tags })),
      others: all.filter((p) => p.slug !== page.slug),
    },
  }));
}

interface Props {
  page: { slug: string; name: string; intro: string };
  recipes: { slug: string; title: string; image: string | null; totalTime: string | null; servings: string | null; ingredients: string[]; tags?: string[] }[];
  others: { slug: string; name: string; count: number }[];
}
const { page, recipes: rawRecipes, others } = Astro.props as Props;
const recipes = await Promise.all(rawRecipes.map(async (r) => { const img = await cardImage(r.image); return { ...r, image: img?.src ?? r.image, imageSet: img?.set ?? null }; }));

const SITE = 'https://www.simpler.recipes';
const pageUrl = `${SITE}/browse/${page.slug}/`;
const top = recipes.slice(0, 3).map((r) => r.title);
const title = `${page.name} — ${recipes.length} recipes, no ads · Simpler Recipes`;
const description = `${page.intro} ${recipes.length} recipes including ${top.join(', ')}. Ad-free, with check-off ingredients, scaling and Cook Mode.`;

const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'CollectionPage',
      '@id': pageUrl,
      url: pageUrl,
      name: page.name,
      description: page.intro,
      isPartOf: { '@type': 'WebSite', name: 'Simpler Recipes', url: `${SITE}/` },
      mainEntity: {
        '@type': 'ItemList',
        numberOfItems: recipes.length,
        itemListElement: recipes.map((r, i) => ({ '@type': 'ListItem', position: i + 1, url: `${SITE}/recipes/${r.slug}/`, name: r.title, ...(r.image ? { image: r.image } : {}) })),
      },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Simpler Recipes', item: `${SITE}/` },
        { '@type': 'ListItem', position: 2, name: page.name, item: pageUrl },
      ],
    },
  ],
}).replace(/</g, '\\u003c');
---

<BaseLayout title={title} description={description} canonical={pageUrl}>
  <Fragment slot="head">
    <script type="application/ld+json" is:inline set:html={jsonLd} />
  </Fragment>

  <main id="main-content" class="min-h-screen bg-background">
    <div class="max-w-[1080px] mx-auto px-4 sm:px-6 py-6 md:py-10">
      <nav aria-label="Breadcrumb" class="mb-8">
        <ol class="flex items-center gap-2 text-[14px] text-sand-600">
          <li><a href="/" class="hover:text-sand-900">Home</a></li>
          <li aria-hidden="true" class="text-sand-400">/</li>
          <li aria-current="page" class="text-sand-800">{page.name}</li>
        </ol>
      </nav>

      <header class="mb-8 max-w-2xl">
        <h1 class="font-serif text-[28px] sm:text-[34px] leading-[1.2] font-medium tracking-[-0.01em] text-sand-900">{page.name}</h1>
        <p class="mt-2 text-[16px] text-sand-600">{page.intro} <span class="text-sand-500 tabular">{recipes.length} recipes.</span></p>
      </header>

      <section aria-label={page.name}>
        <RecipeGrid client:visible recipes={recipes} />
      </section>

      <aside aria-labelledby="clean-own" class="mt-14 pt-8 border-t border-sand-200 max-w-xl">
        <h2 id="clean-own" class="font-serif text-[20px] font-medium text-sand-900">Found a recipe somewhere else?</h2>
        <p class="mt-1 mb-4 text-[15px] text-sand-600">Paste the link and get just the recipe — no ads, no life story.</p>
        <CleanBox client:visible id="browse-clean" />
      </aside>

      <nav aria-labelledby="more-browse" class="mt-14 pt-8 border-t border-sand-200">
        <h2 id="more-browse" class="font-mono text-[12px] uppercase tracking-[0.08em] text-sand-500 mb-3">More ways to browse</h2>
        <ul class="flex flex-wrap gap-x-5 gap-y-2 text-[15px]">
          {others.map((o) => (
            <li><a href={`/browse/${o.slug}/`} class="text-sand-800 hover:text-sand-900 underline underline-offset-[3px] decoration-sand-300">{o.name} <span class="text-sand-500 tabular">{o.count}</span></a></li>
          ))}
        </ul>
      </nav>
    </div>
  </main>
</BaseLayout>
