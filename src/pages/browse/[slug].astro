---
import BaseLayout from '../../layouts/BaseLayout.astro';
import RecipeGrid from '../../components/RecipeGrid.jsx';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ListingHeader from '../../components/ListingHeader.astro';
import CleanBoxCard from '../../components/CleanBoxCard.astro';
import BrowseChips from '../../components/BrowseChips.astro';
import fs from 'fs';
import path from 'path';
import { buildBrowsePages } from '../../lib/browse';
import { cardImage } from '../../lib/images';
import { jsonLd, breadcrumbLd, collectionPageLd, SITE } from '../../lib/schema';

export async function getStaticPaths() {
  const dataPath = path.join(process.cwd(), 'recipe-data', 'all-recipes.json');
  const data = JSON.parse(fs.readFileSync(dataPath, 'utf-8'));
  const pages = buildBrowsePages(data.recipes);
  const all = pages.map((p) => ({ slug: p.slug, name: p.name, family: p.family, count: p.recipes.length }));
  return pages.map((page) => ({
    params: { slug: page.slug },
    props: {
      page: { slug: page.slug, name: page.name, intro: page.intro },
      recipes: page.recipes.map((r) => ({ slug: r.slug, title: r.title, image: r.image, totalTime: r.totalTime, servings: r.servings, ingredients: r.ingredients, tags: r.tags })),
      // Same-family pages first, topped up to 8; the full directory is one click away.
      others: [...all.filter((p) => p.slug !== page.slug && p.family === page.family), ...all.filter((p) => p.slug !== page.slug && p.family !== page.family)].slice(0, 8),
    },
  }));
}

interface Props {
  page: { slug: string; name: string; intro: string };
  recipes: { slug: string; title: string; image: string | null; totalTime: string | null; servings: string | null; ingredients: string[]; tags?: string[] }[];
  others: { slug: string; name: string; count: number }[];
}
const { page, recipes: rawRecipes, others } = Astro.props as Props;
const recipes = await Promise.all(rawRecipes.map(async (r) => { const img = await cardImage(r.image); return { ...r, image: img?.src ?? r.image, imageSet: img?.set ?? null }; }));

const pageUrl = `${SITE}/browse/${page.slug}/`;
const top = recipes.slice(0, 3).map((r) => r.title);
const title = `${page.name} — ${recipes.length} recipes, no ads · Simpler Recipes`;
const description = `${page.intro} ${recipes.length} recipes including ${top.join(', ')}. Ad-free, with check-off ingredients, scaling and Cook Mode.`;

const crumbs = [{ name: page.name }];
const ld = jsonLd(
  collectionPageLd({ url: pageUrl, name: page.name, description: page.intro, items: recipes.map((r) => ({ url: `/recipes/${r.slug}/`, name: r.title, image: r.image })) }),
  breadcrumbLd(crumbs, pageUrl)
);
---

<BaseLayout title={title} description={description} canonical={pageUrl}>
  <Fragment slot="head">
    <script type="application/ld+json" is:inline set:html={ld} />
  </Fragment>

  <main id="main-content" class="min-h-screen bg-background">
    <div class="max-w-[1080px] mx-auto px-4 sm:px-6 py-6 md:py-10">
      <Breadcrumbs crumbs={crumbs} />
      <ListingHeader title={page.name} intro={page.intro} count={recipes.length} />

      <section aria-label={page.name}>
        <RecipeGrid client:visible recipes={recipes} />
      </section>

      <CleanBoxCard id="browse-clean" />
      <BrowseChips items={others.map((o) => ({ name: o.name, href: `/browse/${o.slug}/`, count: o.count }))} />
    </div>
  </main>
</BaseLayout>
