---
import BaseLayout from '../../layouts/BaseLayout.astro';
import RecipeView from '../../components/recipe/RecipeView.jsx';
import RemixButton from '../../components/RemixButton.jsx';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { jsonLd, breadcrumbLd } from '../../lib/schema';
import fs from 'fs';
import path from 'path';
import { durationToMinutes, minutesToIso, formatMinutes, normalizeYield } from '../../lib/recipe/normalize';
import { prettySiteName } from '../../lib/recipe/display';
import { optimizeRemote } from '../../lib/images';

export async function getStaticPaths() {
  const dataPath = path.join(process.cwd(), 'recipe-data', 'all-recipes.json');
  const data = JSON.parse(fs.readFileSync(dataPath, 'utf-8'));
  const collections = data.collections as { slug: string; name: string; recipes: string[] }[];
  const bySlug = new Map<string, any>(data.recipes.map((r: any) => [r.slug, r]));

  return data.recipes.map((recipe: any) => {
    // Collection this recipe belongs to (first one listing it), for breadcrumb + related.
    const collection = collections.find((c) => c.recipes.includes(recipe.slug)) || null;
    const related = collection
      ? collection.recipes
          .filter((s, i, a) => s !== recipe.slug && a.indexOf(s) === i)
          .map((s) => bySlug.get(s))
          .filter(Boolean)
          .slice(0, 4)
          .map((r: any) => ({ slug: r.slug, title: r.title, image: r.image, totalTime: r.totalTime }))
      : [];
    return {
      params: { slug: recipe.slug },
      props: { recipe, collection: collection ? { slug: collection.slug, name: collection.name } : null, related },
    };
  });
}

interface Props {
  recipe: any;
  collection: { slug: string; name: string } | null;
  related: { slug: string; title: string; image: string | null; totalTime: string | null }[];
}
const { recipe: rawRecipe, collection, related: rawRelated } = Astro.props as Props;
const heroImg = await optimizeRemote(rawRecipe.image, 800, 600, 78);
// The view gets the optimized hero; schema/OG keep the original (full-size, canonical) URL.
const recipe = { ...rawRecipe, image: heroImg?.src ?? rawRecipe.image };
const related = await Promise.all(rawRelated.map(async (r) => ({ ...r, image: (await optimizeRemote(r.image, 400, 300))?.src ?? r.image })));

const SITE = 'https://www.simpler.recipes';
const pageUrl = `${SITE}/recipes/${recipe.slug}/`;
const prepMin = durationToMinutes(recipe.prepTime);
const cookMin = durationToMinutes(recipe.cookTime);
let totalMin = durationToMinutes(recipe.totalTime);
if (totalMin == null && (prepMin || cookMin)) totalMin = (prepMin || 0) + (cookMin || 0);
if (totalMin != null && prepMin != null && cookMin != null && totalMin < prepMin + cookMin) totalMin = prepMin + cookMin;
const yieldInfo = normalizeYield(recipe.servings);
const totalHuman = formatMinutes(totalMin);

// Natural, useful metadata (no robotic templates).
const title = `${recipe.title}${totalHuman ? ` (${totalHuman})` : ''} · Simpler Recipes`;
const descBits = [
  `${recipe.title}: ${recipe.ingredients.length} ingredients, ${recipe.instructions.length} steps`,
  totalHuman ? `ready in ${totalHuman}` : null,
  yieldInfo.text ? `makes ${yieldInfo.text}` : null,
].filter(Boolean);
const description = `${descBits.join(', ')}. Ad-free, with check-off ingredients, scaling and a hands-free Cook Mode.${recipe.source?.name ? ` From ${prettySiteName(recipe.source.name)}.` : ''}`;

// schema.org — only what we know; never fabricated ratings/nutrition/publish dates.
const recipeSchema: Record<string, unknown> = {
  '@type': 'Recipe',
  '@id': `${pageUrl}#recipe`,
  name: recipe.title,
  url: pageUrl,
  mainEntityOfPage: pageUrl,
  // schema.org requires absolute URLs; self-hosted photos are stored as site-relative paths.
  image: rawRecipe.image ? [rawRecipe.image.startsWith('http') ? rawRecipe.image : `${SITE}${rawRecipe.image}`] : undefined,
  author: recipe.source?.name ? { '@type': 'Organization', name: prettySiteName(recipe.source.name), url: recipe.source.url } : undefined,
  isBasedOn: recipe.source?.url || undefined,
  prepTime: minutesToIso(prepMin),
  cookTime: minutesToIso(cookMin),
  totalTime: minutesToIso(totalMin),
  recipeYield: yieldInfo.text || undefined,
  keywords: recipe.tags?.length ? recipe.tags.join(', ') : undefined,
  recipeIngredient: recipe.ingredients,
  recipeInstructions: recipe.instructions.map((step: string, i: number) => ({ '@type': 'HowToStep', position: i + 1, text: step })),
};
for (const k of Object.keys(recipeSchema)) if (recipeSchema[k] === undefined) delete recipeSchema[k];

const crumbs = [
  ...(collection ? [{ name: collection.name, href: `/collection/${collection.slug}/` }] : []),
  { name: recipe.title },
];
const ld = jsonLd(recipeSchema, breadcrumbLd(crumbs, pageUrl));
---

<BaseLayout title={title} description={description} image={rawRecipe.image} type="article" canonical={pageUrl}>
  <Fragment slot="head">
    <script type="application/ld+json" is:inline set:html={ld} />
  </Fragment>

  <main id="main-content" class="min-h-screen bg-background">
    <div class="max-w-[1080px] mx-auto px-4 sm:px-6 pt-5 print:hidden">
      <Breadcrumbs crumbs={crumbs} class="mb-0" />
    </div>

    <RecipeView client:load recipe={recipe} recipeId={recipe.slug} sourceUrl={recipe.source?.url} variant="curated">
      <RemixButton client:visible recipe={recipe} variant="link" slot="remix" />
    </RecipeView>

    {related.length > 0 && (
      <section aria-labelledby="related-heading" data-print-hide class="max-w-[1080px] mx-auto px-4 sm:px-6 pb-16 print:hidden">
        <h2 id="related-heading" class="font-mono text-[12px] uppercase tracking-[0.08em] text-sand-500 mb-4">
          More {collection?.name ? `in ${collection.name}` : 'like this'}
        </h2>
        <ul class="grid grid-cols-2 sm:grid-cols-4 gap-4">
          {related.map((r) => (
            <li>
              <a href={`/recipes/${r.slug}/`} class="group block">
                <div class="aspect-[4/3] rounded-xl overflow-hidden bg-sand-100 mb-2">
                  {r.image && (
                    <img src={r.image} alt="" width={400} height={300} loading="lazy" decoding="async" class="w-full h-full object-cover dark:brightness-90 group-hover:opacity-95" referrerpolicy="no-referrer" />
                  )}
                </div>
                <p class="text-[15px] font-medium text-sand-900 leading-snug line-clamp-2 group-hover:underline underline-offset-2">{r.title}</p>
                {r.totalTime && <p class="text-[13px] text-sand-500 mt-0.5">{formatMinutes(durationToMinutes(r.totalTime)) || r.totalTime}</p>}
              </a>
            </li>
          ))}
        </ul>
        {collection && (
          <p class="mt-5 text-[14px]">
            <a href={`/collection/${collection.slug}/`} class="text-sand-700 hover:text-sand-900 underline underline-offset-[3px] decoration-sand-300">All {collection.name} →</a>
          </p>
        )}
      </section>
    )}
  </main>
</BaseLayout>
