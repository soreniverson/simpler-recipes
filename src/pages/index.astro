---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroInput from '../components/HeroInput.jsx';
import fs from 'fs';
import path from 'path';

// Collections at build time. Ordered by usefulness for "what's for dinner", not alphabetically.
const dataPath = path.join(process.cwd(), 'recipe-data', 'all-recipes.json');
const data = JSON.parse(fs.readFileSync(dataPath, 'utf-8'));
const ORDER = [
  'quick-weeknight-dinners', 'one-pot-meals', 'comfort-food-classics', 'vegetarian-mains', 'soups-stews', 'healthy-lunches',
  'italian-classics', 'asian-inspired', 'indian-cuisine', 'mexican-favorites', 'mediterranean-mezze', 'grilling-bbq',
  'breakfast-brunch', 'baking-basics', 'desserts-sweets', 'appetizers-party',
];
const collections = [...data.collections].sort((a: any, b: any) => {
  const ia = ORDER.indexOf(a.slug), ib = ORDER.indexOf(b.slug);
  return (ia === -1 ? 99 : ia) - (ib === -1 ? 99 : ib);
});
const recipeCount = data.recipes.length;

const title = 'Simpler Recipes — paste any recipe link, get just the recipe';
const description = `Paste a recipe link and get the ingredients and steps with nothing else: no ads, no pop-ups, no life story. Or browse ${recipeCount} clean recipes with check-off ingredients, scaling and a hands-free Cook Mode.`;

const websiteSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Simpler Recipes',
  url: 'https://www.simpler.recipes/',
  description,
});
---

<BaseLayout title={title} description={description} headerSearch={false}>
  <Fragment slot="head">
    <script type="application/ld+json" is:inline set:html={websiteSchema} />
  </Fragment>

  <main id="main-content" class="min-h-screen">
    <div class="max-w-[1080px] mx-auto px-4 sm:px-6">
      <!-- Hero: one promise, one input, and the food. The collage is the brand moment; it is
           desktop-only (it was always `hidden lg:block`) and now ships as a 38KB WebP. -->
      <section class="pt-10 sm:pt-16 pb-10 sm:pb-14" aria-labelledby="hero-heading">
        <div class="lg:flex lg:items-center lg:gap-14">
          <div class="flex-1 lg:max-w-xl min-w-0">
            <h1 id="hero-heading" class="font-serif text-[34px] sm:text-[44px] leading-[1.18] font-medium tracking-[-0.01em] text-sand-900 [text-wrap:balance]">
              Just <span class="hl">the recipe.</span><br />Nothing <span class="underline decoration-accent decoration-[3px] underline-offset-[6px]">else</span>.
            </h1>
            <p class="mt-4 text-[16px] sm:text-[17px] leading-relaxed text-sand-600 max-w-[42ch]">
              Paste a recipe link and get the ingredients and steps — no ads, no pop-ups, no life story.
            </p>
            <div class="mt-6 sm:mt-8">
              <HeroInput client:load />
            </div>
          </div>
          <div class="hidden lg:block shrink-0 w-[300px] xl:w-[340px]" aria-hidden="true">
            <img
              src="/hero-collage-384.webp"
              srcset="/hero-collage-384.webp 384w, /hero-collage-768.webp 768w"
              sizes="340px"
              alt=""
              width={340}
              height={340}
              class="w-full h-auto rounded-2xl"
              loading="eager"
              fetchpriority="high"
              decoding="async"
            />
          </div>
        </div>
      </section>

      <!-- Browse -->
      <section aria-labelledby="collections-heading" class="pb-16">
        <div class="flex items-baseline justify-between gap-4 mb-5">
          <h2 id="collections-heading" class="text-[15px] font-medium text-sand-900">
            Or browse {recipeCount} recipes
          </h2>
          <a href="/browse/" class="text-[14px] text-sand-600 hover:text-sand-900 underline underline-offset-[3px] decoration-sand-300 shrink-0">
            By ingredient &amp; time
          </a>
        </div>
        <nav aria-label="Recipe collections">
          <ul class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-x-10 gap-y-0">
            {collections.map((c: any) => (
              <li class="border-b border-sand-200/70">
                <a href={`/collection/${c.slug}/`} class="group flex items-baseline justify-between gap-4 py-3">
                  <span class="text-[16px] text-sand-800 group-hover:text-sand-900 group-hover:underline underline-offset-[3px] decoration-sand-300">{c.name}</span>
                  <span class="font-mono text-[12px] text-sand-400 shrink-0">{c.recipeCount}</span>
                </a>
              </li>
            ))}
          </ul>
        </nav>
      </section>

      <footer class="pb-10 flex flex-wrap items-center gap-x-6 gap-y-2 text-[13px] text-sand-500">
        <a href="/privacy" class="hover:text-sand-800">Privacy</a>
        <span>Recipes stay credited to the sites they came from — every page links back to the original.</span>
      </footer>
    </div>
  </main>
</BaseLayout>
