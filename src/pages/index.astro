---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroInput from '../components/HeroInput.jsx';
import fs from 'fs';
import path from 'path';

// Collections at build time. Ordered by usefulness for "what's for dinner", not alphabetically.
const dataPath = path.join(process.cwd(), 'recipe-data', 'all-recipes.json');
const data = JSON.parse(fs.readFileSync(dataPath, 'utf-8'));
const ORDER = [
  'quick-weeknight-dinners', 'one-pot-meals', 'comfort-food-classics', 'vegetarian-mains', 'soups-stews', 'healthy-lunches',
  'italian-classics', 'asian-inspired', 'indian-cuisine', 'mexican-favorites', 'mediterranean-mezze', 'grilling-bbq',
  'breakfast-brunch', 'baking-basics', 'desserts-sweets', 'appetizers-party',
];
const bySlug = new Map(data.recipes.map((r: any) => [r.slug, r]));
const collections = [...data.collections]
  .sort((a: any, b: any) => {
    const ia = ORDER.indexOf(a.slug), ib = ORDER.indexOf(b.slug);
    return (ia === -1 ? 99 : ia) - (ib === -1 ? 99 : ib);
  })
  // Each collection gets a cover: the first of its recipes that has a photo.
  .map((c: any) => ({ ...c, cover: c.recipes.map((s: string) => (bySlug.get(s) as any)?.image).find(Boolean) || null }));
const recipeCount = data.recipes.length;

const title = 'Simpler Recipes — paste any recipe link, get just the recipe';
const description = `Paste a recipe link and get the ingredients and steps with nothing else: no ads, no pop-ups, no life story. Or browse ${recipeCount} clean recipes with check-off ingredients, scaling and a hands-free Cook Mode.`;

const websiteSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Simpler Recipes',
  url: 'https://www.simpler.recipes/',
  description,
});
---

<BaseLayout title={title} description={description} headerSearch={false}>
  <Fragment slot="head">
    <script type="application/ld+json" is:inline set:html={websiteSchema} />
  </Fragment>

  <main id="main-content" class="min-h-screen">
    <div class="max-w-[1080px] mx-auto px-4 sm:px-6">
      <!-- Hero: one axis, one focal point. Centered column, the input is the hero object,
           and the food imagery is the (clickable) collection grid below — no decorative collage
           competing with the headline. -->
      <section class="pt-12 sm:pt-20 pb-12 sm:pb-16" aria-labelledby="hero-heading">
        <div class="max-w-[640px] mx-auto text-center">
          <h1 id="hero-heading" class="font-serif text-[36px] sm:text-[48px] leading-[1.15] font-medium tracking-[-0.01em] text-sand-900 [text-wrap:balance]">
            Just <span class="hl">the recipe.</span><br />Nothing else.
          </h1>
          <p class="mt-4 text-[16px] sm:text-[17px] leading-relaxed text-sand-600">
            The ingredients and the steps — no ads, no pop-ups, no life story.
          </p>
          <div class="mt-7 sm:mt-9 text-left">
            <HeroInput client:load />
          </div>
        </div>
      </section>

      <!-- Browse: image-led collection grid. One title style (serif), one meta style (mono). -->
      <section aria-labelledby="collections-heading" class="pb-16">
        <div class="flex items-baseline justify-between gap-4 mb-6">
          <h2 id="collections-heading" class="font-mono text-[12px] uppercase tracking-[0.08em] text-sand-500">
            Browse {recipeCount} recipes
          </h2>
          <a href="/browse/" class="text-[14px] text-sand-600 hover:text-sand-900 underline underline-offset-[3px] decoration-sand-300 shrink-0">
            By ingredient &amp; time
          </a>
        </div>
        <nav aria-label="Recipe collections">
          <ul class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-x-5 gap-y-8">
            {collections.map((c: any) => (
              <li>
                <a href={`/collection/${c.slug}/`} class="group block">
                  <div class="aspect-[4/3] overflow-hidden rounded-xl bg-sand-100 mb-2.5">
                    {c.cover && (
                      <img
                        src={c.cover}
                        alt=""
                        width={320}
                        height={240}
                        loading="lazy"
                        decoding="async"
                        class="w-full h-full object-cover dark:brightness-90 group-hover:opacity-95 transition-opacity"
                        referrerpolicy="no-referrer"
                      />
                    )}
                  </div>
                  <h3 class="font-serif text-[16px] font-medium leading-snug text-sand-900 group-hover:underline underline-offset-[3px] decoration-sand-300">{c.name}</h3>
                  <p class="mt-0.5 font-mono text-[11px] text-sand-500">{c.recipeCount} recipes</p>
                </a>
              </li>
            ))}
          </ul>
        </nav>
      </section>

      <footer class="pb-10 flex flex-wrap items-center gap-x-5 gap-y-2 text-[13px] text-sand-500">
        <a href="/privacy" class="hover:text-sand-800 underline underline-offset-[3px] decoration-sand-300">Privacy</a>
        <span>Recipes stay on your device — every page links back to the original site.</span>
      </footer>
    </div>
  </main>
</BaseLayout>
